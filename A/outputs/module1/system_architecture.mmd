%% 系统框图：粗线 = 能量流，细线 = 采样/控制信号，虚线 = 保护/故障路径
flowchart LR
    subgraph EXT_IN[外部]
        PSU["实验电源<br/>5 V ±5%，≈1.5 A"]
    end

    subgraph MOD_IN["MOD-IN 输入接口与保护"]
        J1["J1 输入端子"] ==> F1["F1 保险丝"] ==> Q2["Q2 PMOS<br/>防反接 + 缓启动"] ==> CIN["Cin 输入电容"]
    end

    subgraph MOD_PWR["MOD-PWR Boost 功率级 (100 kHz)"]
        L1["L1 68 µH"] ==> SWN(("SW")) ==> D1["D1 肖特基"] ==> COUT["Cout 陶瓷 + 电解"]
        SWN ==> Q1["Q1 N-MOSFET"] ==> PGND(("PGND"))
    end

    subgraph MOD_SENSE["MOD-SENSE 采样调理"]
        RS["R1 分流 50 mΩ"] --> CSA["U3 电流检测放大器 ×50"]
        VDIV["Vout 分压 43k/10k + RC"]
        IDIV["Vin 分压 10k/10k + RC"]
    end

    subgraph MOD_OUT["MOD-OUT 输出接口"]
        TVS["D2 TVS"]
        J2["J2 输出端子"]
    end

    subgraph EXT_OUT[外部]
        LOAD["电子负载<br/>CV 测试用 CC 模式 / CC 测试用 CR 模式"]
    end

    subgraph MOD_MCU["MOD-MCU STM32G431 控制核心"]
        ADC["ADC1/ADC2<br/>TIM1 触发 + 过采样"]
        CTRL["数字 PI ×2<br/>CV/CC 最小值选择<br/>软启动 / 状态机"]
        TIM["TIM1 PWM CH1<br/>Dmax 限幅"]
        COMP["COMP1/COMP3<br/>+ 内部 DAC3 阈值"]
        BRK["TIM1 刹车"]
        LOG["USART1 日志"]
        ADC --> CTRL --> TIM
        COMP -.硬件 OVP/OCP.-> BRK -.封锁.-> TIM
        CTRL --> LOG
    end

    subgraph MOD_DRV["MOD-DRV 栅极驱动"]
        DRV["U2 低边驱动器<br/>3.3 V 逻辑 → 5 V 栅极"]
    end

    subgraph MOD_AUX["MOD-AUX 辅助电源"]
        LDO["U4 LDO 5 V→3.3 V"]
    end

    subgraph MOD_DBG["MOD-DBG 调试/人机"]
        SWD["SWD 排针"]
        UART["UART 排针"]
        LED["LED: 运行/CC/故障<br/>按键: 使能/清故障"]
    end

    PSU ==> J1
    CIN ==> L1
    COUT ==> RS ==> TVS ==> J2 ==> LOAD
    CIN -- 5 V --> LDO -- 3V3 --> MOD_MCU
    LDO -- 3V3 --> CSA
    CIN -- VDD --> DRV

    TIM -- PWM_H --> DRV -- GATE --> Q1
    CSA -- IOUT_SNS --> ADC
    CSA -- IOUT_SNS --> COMP
    J2 -.- VDIV
    VDIV -- VOUT_SNS --> ADC
    VDIV -- VOUT_SNS --> COMP
    CIN -.- IDIV
    IDIV -- VIN_SNS --> ADC
    LOG --> UART
    SWD --- MOD_MCU
    CTRL --> LED

    linkStyle default stroke-width:1px
