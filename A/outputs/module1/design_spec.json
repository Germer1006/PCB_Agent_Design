  "functional_blocks": [
    {
      "id": "MOD-IN",
      "name": "输入接口与保护",
      "function": "接线端子、保险丝、防反接/缓启动 PMOS、输入电容",
      "impl": "硬件",
      "requirements": [
        "REQ-VIN",
        "REQ-PROT"
      ]
    },
    {
      "id": "MOD-PWR",
      "name": "Boost 功率级",
      "function": "电感、开关管、肖特基二极管、输出电容；把 5 V 升至 12 V",
      "impl": "硬件",
      "requirements": [
        "REQ-VOUT",
        "REQ-PWR",
        "REQ-FSW",
        "REQ-RIP",
        "REQ-EFF"
      ]
    },
    {
      "id": "MOD-DRV",
      "name": "栅极驱动",
      "function": "把 MCU 3.3 V PWM 转为 5 V/安培级栅极驱动，缩短开关时间",
      "impl": "硬件",
      "requirements": [
        "REQ-EFF"
      ]
    },
    {
      "id": "MOD-SENSE",
      "name": "采样调理",
      "function": "输出电压分压+RC、输出电流高边分流+电流检测放大器、输入电压分压",
      "impl": "硬件",
      "requirements": [
        "REQ-VOUT",
        "REQ-IOUT",
        "REQ-PROT"
      ]
    },
    {
      "id": "MOD-MCU",
      "name": "MCU 控制核心",
      "function": "ADC 采样、数字 PI CC/CV、PWM、比较器硬件保护、状态机、日志",
      "impl": "硬件+固件",
      "requirements": [
        "REQ-MCU",
        "REQ-CTRL",
        "REQ-PROT"
      ]
    },
    {
      "id": "MOD-AUX",
      "name": "辅助电源",
      "function": "5 V → 3.3 V LDO（MCU/ADC 基准/放大器供电），输入 RC 去耦",
      "impl": "硬件",
      "requirements": [
        "REQ-MCU"
      ]
    },
    {
      "id": "MOD-OUT",
      "name": "输出接口与保护",
      "function": "输出端子、TVS、测试点",
      "impl": "硬件",
      "requirements": [
        "REQ-PROT",
        "REQ-LOAD"
      ]
    },
    {
      "id": "MOD-DBG",
      "name": "调试与人机接口",
      "function": "SWD 下载口、UART 日志口、状态/故障 LED、使能按键",
      "impl": "硬件+固件",
      "requirements": [
        "REQ-TEST"
      ]
    }
  ],
