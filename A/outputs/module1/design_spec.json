    },
    {
      "name": "SWDIO",
      "desc": "调试",
      "class": "debug"
    },
    {
      "name": "SWCLK",
      "desc": "调试",
      "class": "debug"
    },
    {
      "name": "NRST",
      "desc": "复位",
      "class": "debug"
    },
    {
      "name": "UART_TX",
      "desc": "日志输出",
      "class": "debug"
    },
    {
      "name": "UART_RX",
      "desc": "命令输入",
      "class": "debug"
    }
  ],
  "interfaces": [
    {
      "id": "IF-01",
      "signal": "PWM_H",
      "from": "MOD-MCU",
      "to": "MOD-DRV",
      "type": "数字 3.3 V",
      "spec": "100 kHz，0–80% 占空比，高有效；复位期间下拉为低"
    },
    {
      "id": "IF-02",
      "signal": "GATE",
      "from": "MOD-DRV",
      "to": "MOD-PWR",
      "type": "栅极驱动",
      "spec": "0/Vin 摆幅，tr≈16.51 ns, tf≈13.38 ns（估）"
    },
    {
      "id": "IF-03",
      "signal": "VOUT_SNS",
      "from": "MOD-SENSE",
      "to": "MOD-MCU (ADC + COMP)",
      "type": "模拟 0–3.3 V",
      "spec": "Vout = code × 3.3/4095 / 0.1887；12 V→code 2810；满量程 17.49 V"
    },
    {
      "id": "IF-04",
      "signal": "IOUT_SNS",
      "from": "MOD-SENSE",
      "to": "MOD-MCU (ADC + COMP)",
      "type": "模拟 0–3.3 V",
      "spec": "Iout = code × 3.3/4095 / 2.5；0.5 A→code 1551；满量程 1.3 A"
    },
    {
      "id": "IF-05",
      "signal": "VIN_SNS",
      "from": "MOD-SENSE",
      "to": "MOD-MCU (ADC)",
      "type": "模拟 0–3.3 V",
      "spec": "Vin = code × 3.3/4095 / 0.5；满量程 6.6 V"
    },
    {
      "id": "IF-06",
      "signal": "+3V3",
      "from": "MOD-AUX",
      "to": "MOD-MCU, MOD-SENSE",
      "type": "电源",
      "spec": "3.3 V，负载约 39.3 mA；同时作为 ADC 基准（VDDA）"
    },
    {
      "id": "IF-07",
      "signal": "SWD/UART",
      "from": "MOD-DBG",
      "to": "PC",
      "type": "调试",
      "spec": "SWD 4 线 + UART 115200 bps，日志 50 Hz"
    },
    {
      "id": "IF-08",
      "signal": "VIN_RAW/VOUT",
      "from": "实验电源/电子负载",
      "to": "MOD-IN/MOD-OUT",
      "type": "功率端子",
      "spec": "输入 5 V ±5%，约 1.487 A；输出 12 V/0.5 A；CR 测 CC 段 12.5–24.0 Ω"
    }
  ],
