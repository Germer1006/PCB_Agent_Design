      "desc": "输出电压分压点 → ADC/COMP",
      "class": "analog"
    },
    {
      "name": "IOUT_SNS",
      "desc": "电流放大器输出 → ADC/COMP",
      "class": "analog"
    },
    {
      "name": "VIN_SNS",
      "desc": "输入电压分压点 → ADC",
      "class": "analog"
    },
    {
      "name": "+3V3",
      "desc": "LDO 输出",
      "class": "power-aux"
    },
    {
