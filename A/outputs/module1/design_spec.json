  "requirements": [
    {
      "id": "REQ-VIN",
      "text": "输入 5 V ±5%",
      "level": "must"
    },
    {
      "id": "REQ-VOUT",
      "text": "输出 12 V，误差 ≤ ±5%",
      "level": "must"
    },
    {
      "id": "REQ-IOUT",
      "text": "恒流 0.5 A，误差 ≤ ±5%",
      "level": "must"
    },
    {
      "id": "REQ-PWR",
      "text": "额定 6 W 连续运行",
      "level": "must"
    },
    {
      "id": "REQ-FSW",
      "text": "开关频率 50–100 kHz（采用 100 kHz）",
      "level": "must"
    },
    {
      "id": "REQ-RIP",
      "text": "纹波 ≤5%（目标 ≤3%）",
      "level": "must"
    },
    {
      "id": "REQ-MCU",
      "text": "32 位 MCU（STM32）",
      "level": "must"
    },
    {
      "id": "REQ-CTRL",
      "text": "数字 PI CC/CV",
      "level": "must"
    },
    {
      "id": "REQ-PROT",
      "text": "过压/过流/占空比限幅/软启动",
      "level": "must"
    },
    {
      "id": "REQ-EFF",
      "text": "额定效率 ≥ 75%（实测）",
      "level": "target"
    },
    {
      "id": "REQ-LOAD",
      "text": "电子负载 CC/CR 测试",
      "level": "must"
    },
    {
      "id": "REQ-PCB",
      "text": "两层板，功率/控制分区",
      "level": "must"
    },
    {
      "id": "REQ-TEST",
      "text": "调试与测试接口",
      "level": "must"
    }
  ],
  "topology": {
    "type": "async_boost",
    "fsw_hz": 100000,
    "rationale": "非同步 Boost：Vin(4.75–5.25 V) 恒低于 Vo(12 V)，无需降压能力；单路低边 PWM，轻载自然 DCM 无反向电流，调试风险最低；二极管损耗约 0.24 W（≈4%），效率目标 75% 余量充足。同步 Boost 增加高边驱动/死区/轻载反流管理；SEPIC 多一个电感与耦合电容；专用 Boost IC 闭环在芯片内，不满足“MCU 数字 PI”要求。见 design_rules.md §2。"
  },
