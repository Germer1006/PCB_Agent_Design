    {
      "id": "R1",
      "name": "输出纹波：仅电容放电（简化公式对照）",
      "formula": "ΔVc = Io·D/(fsw·Ctot)",
      "substitution": "0.5×0.6381/(100000×106.0µ)",
      "value": 30.11,
      "unit": "mV",
      "note": "把电解电容当理想电容，偏乐观"
    },
    {
      "id": "R2",
      "name": "输出纹波：谐波叠加（计 ESR 与支路分流）",
      "formula": "v(t)=Σ In·Zout(n·fsw)",
      "substitution": "二极管电流梯形波 1.60→1.16 A，D=0.6381",
      "value": 55.82,
      "unit": "mV",
      "note": "Zout = 各电容支路 (ESR + 1/jωC) 与负载并联；60 次谐波"
    },
    {
      "id": "R3",
      "name": "输出纹波估算（峰峰值/直流）",
      "formula": "Vpp/Vo",
      "substitution": "55.8m/12.0",
      "value": 0.4652,
      "unit": "%",
      "note": "未计 ESL 与开关尖峰（取决于 PCB 布局与测量方法，建议 20 MHz 带宽限制、弹簧地针测量）"
    },
    {
      "id": "G1",
      "name": "升压比峰值点（Vin_min, 满载）",
      "formula": "max Vo(D)",
      "substitution": "D=0.914",
      "value": 27.23,
      "unit": "V",
      "note": "Dmax 必须低于此 D，否则过载时增大占空比反而降低输出，环路失去单调性"
    },
    {
      "id": "U1",
      "name": "热插拔上电浪涌峰值（估）",
      "formula": "I ≈ (Vin−VF)/√(L/C)·e^(−ζπ/2/√(1−ζ²))",
      "substitution": "Z0=0.80 Ω, ζ=0.158",
      "value": 4.642,
      "unit": "A",
      "note": "PWM 未启动时输出电容经 L、D 被动充电；建议 PMOS 栅极 RC 缓启动或实验电源限流"
